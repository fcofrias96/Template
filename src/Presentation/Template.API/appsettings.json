{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TemplateMainConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Template;Trusted_Connection=true;MultipleActiveResultSets=True;TrustServerCertificate=true;Encrypt=false",
    "MainMigrationConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Template;Trusted_Connection=true;MultipleActiveResultSets=True;TrustServerCertificate=true;Encrypt=false",
    "TemplateSecurityConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Template.Security;Trusted_Connection=true;MultipleActiveResultSets=True;TrustServerCertificate=true;Encrypt=false",
    "SecurityMigrationConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Template.Security;Trusted_Connection=true;MultipleActiveResultSets=True;TrustServerCertificate=true;Encrypt=false",
    "TemplateAuditConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Template.Audit;Trusted_Connection=true;MultipleActiveResultSets=True;TrustServerCertificate=true;Encrypt=false"
  },
  "UseInMemoryDatabase": false,
  "JwtSettings": {
    "Key": "your-32-character-long-secret-key",
    "Issuer": "https://api.template.com",
    "Audience": "https://template.com",
    "EmailConfirmationTokenDurationInHours": 24,
    "PasswordResetTokenDurationInHours": 1,
    "LoginTokenDurationInMinutes": 1,
    "RefreshTokenDurationInDays": 7,
    "ChangeEmailTokenDurationInHours": 1
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://localhost:4200",
    "https://template.com"
  ],
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}